# 복사해서 .env.local 로 쓰세요 (.env.local 은 git 에 올라가지 않습니다)

# mock = 예시 데이터 (기본), http = Spring Boot API
VITE_DATA_SOURCE=mock
VITE_API_BASE=/api
# npm run dev 에서 /api 를 넘길 Spring Boot 주소
API_PROXY_TARGET=http://localhost:8080

# browser = /projects 주소 (기본), hash = #/projects 주소 (서버 설정 없는 미리보기용)
VITE_ROUTER=browser

# true = 준비 중 페이지에 팀 기획 메모(와이어프레임 번호, 정할 것)를 보임. npm run dev 에서는 늘 보임
VITE_SHOW_PLAN=false
